    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noImplicitAny": false, "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2021", "DOM"], "noEmit": true, "types": ["node"]
